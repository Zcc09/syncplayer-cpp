<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SyncPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The app's own bar, handed to the system as the title bar so Windows draws the
             minimise / maximise / close buttons and keeps the drag, snap and system menu. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="40" Padding="16,0,8,0"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="SyncPlayer" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="8,2" CornerRadius="10"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <TextBlock Text="2.0.0" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
            <Button x:Name="SettingsButton" Grid.Column="3" Content="Settings"
                    VerticalAlignment="Center" Click="OnSettingsClicked" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0">
            <StackPanel Spacing="8" Padding="0,8,0,16">

                <!-- VIDEOS -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="VIDEOS" FontSize="12" FontWeight="SemiBold"
                                   CharacterSpacing="60"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Spacing="2">
                            <TextBlock Text="Movie" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MovieBox" Grid.Column="0"
                                         PlaceholderText="C:/media/movie.mp4"
                                         TextWrapping="NoWrap" />
                                <Button x:Name="MovieBrowse" Grid.Column="1" Content="Browse..."
                                        Click="OnBrowseMovieClicked" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Reaction" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ReactionBox" Grid.Column="0"
                                         PlaceholderText="C:/media/reaction.mp4"
                                         TextWrapping="NoWrap" />
                                <Button x:Name="ReactionBrowse" Grid.Column="1" Content="Browse..."
                                        Click="OnBrowseReactionClicked" />
                            </Grid>
                        </StackPanel>
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Text="Paste a link, or drop a file onto the window."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- PLAYBACK: transport on one row, the settings on the next. -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="PLAYBACK" FontSize="12" FontWeight="SemiBold"
                                   CharacterSpacing="60"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="StartButton" Content="Start"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnStartClicked" />
                            <Button x:Name="PlayButton" Content="Play" Click="OnPlayClicked" />
                            <Button x:Name="JumpBackButton" Content="&#x2190; 7.5s"
                                    Click="OnJumpBackClicked" />
                            <Button x:Name="JumpForwardButton" Content="7.5s &#x2192;"
                                    Click="OnJumpForwardClicked" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Jump (s)" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="JumpBox" Width="90" Text="5" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Speed" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox x:Name="SpeedBox" Width="90" Text="1.00" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Lock sync to the master bar" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ToggleSwitch x:Name="LockSwitch" OnContent="" OffContent=""
                                              Toggled="OnLockToggled" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="SyncNote" FontSize="12" TextWrapping="Wrap"
                                   Text="Sync unlocked: align with the per-video bars."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- TIMELINES -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TIMELINES" FontSize="12" FontWeight="SemiBold"
                                   CharacterSpacing="60"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Movie" FontSize="13"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="MovieBar" Grid.Column="1" Minimum="0" Maximum="100"
                                    VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="&#x25B6;" Width="36"
                                    Click="OnPlayMovieClicked" />
                            <TextBlock x:Name="MovieTime" Grid.Column="3" Text="00:00 / 00:00"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Reaction" FontSize="13"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="ReactionBar" Grid.Column="1" Minimum="0" Maximum="100"
                                    VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="&#x25B6;" Width="36"
                                    Click="OnPlayReactionClicked" />
                            <TextBlock x:Name="ReactionTime" Grid.Column="3" Text="00:00 / 00:00"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Master" FontSize="13"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="MasterBar" Grid.Column="1" Minimum="0" Maximum="100"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="MasterTime" Grid.Column="2" Text="00:00 / 00:00"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Go to" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="GotoBox" Width="140" PlaceholderText="90 or 1:30:00" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- VOLUME -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="VOLUME" FontSize="12" FontWeight="SemiBold"
                                   CharacterSpacing="60"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MovieVolumeLabel" Grid.Column="0" Text="Movie 100%"
                                       FontSize="13" VerticalAlignment="Center" />
                            <Slider x:Name="MovieVolume" Grid.Column="1" Minimum="0" Maximum="150"
                                    Value="100" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ReactionVolumeLabel" Grid.Column="0"
                                       Text="Reaction 100%" FontSize="13"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="ReactionVolume" Grid.Column="1" Minimum="0" Maximum="150"
                                    Value="100" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MasterVolumeLabel" Grid.Column="0" Text="Master 100%"
                                       FontSize="13" VerticalAlignment="Center" />
                            <Slider x:Name="MasterVolume" Grid.Column="1" Minimum="0" Maximum="150"
                                    Value="100" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- WINDOWS -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="WINDOWS" FontSize="12" FontWeight="SemiBold"
                                   CharacterSpacing="60"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ArrangeButton" Content="Arrange side by side"
                                    Click="OnArrangeClicked" />
                            <Button x:Name="PipButton" Content="Floating PiP"
                                    Click="OnPipClicked" />
                        </StackPanel>
                        <TextBlock FontSize="12" TextWrapping="Wrap"
                                   Text="Floating PiP makes the reaction borderless and always on top."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="2" Padding="16,8,16,12">
            <TextBlock x:Name="StatusLine" Text="Ready." FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="StatusHint" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
